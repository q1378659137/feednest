{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "feednest",
  "main": "../../serverless/worker.js",
  "compatibility_date": "2026-01-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "../../public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "feednest-db",
      "database_id": "REPLACE_WITH_YOUR_D1_ID"
    }
  ],
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "vars": {
    "MAX_FEEDS_PER_RUN": "45"
  }
}
